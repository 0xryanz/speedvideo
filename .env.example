# Copy to .env and replace every secret before deploying.
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters
MEDIA_SIGNING_KEY=replace-with-a-different-32-character-secret
POSTGRES_PASSWORD=speedvideo-local-only
PUBLIC_BASE_URL=http://localhost:8091
CORS_ALLOWED_ORIGINS=*
# Host ports for the API and the operations console.
API_PORT=8091
ADMIN_PORT=8096
ADMIN_API_TOKEN=dev-admin-token
# Development only: allow plain-http provider fixtures (never in production).
COLLECTOR_ALLOW_INSECURE=false
# Development only: allow plain-http playback for local fixtures.
SOURCE_ALLOW_INSECURE=false
